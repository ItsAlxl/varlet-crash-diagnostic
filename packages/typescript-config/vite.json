{
	"extends": "./base.json",
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": [
			"ESNext",
			"DOM"
		],
		"sourceMap": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"noUnusedLocals": true
	},
	"exclude": [
		"node_modules"
	]
}